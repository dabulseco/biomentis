# Biomni Environment Configuration
# Copy this file to .env and fill in your actual settings.
#
# DEFAULT BEHAVIOR: Biomni will use a local Ollama model. Make sure
# `ollama serve` is running and at least one model is pulled (e.g.
# `ollama pull qwen2.5:14b`). No cloud API key is needed.
#
# To use Anthropic (Claude) instead, uncomment the ANTHROPIC_API_KEY line
# below AND set BIOMNI_LLM / BIOMNI_SOURCE so Biomni doesn't keep trying
# Ollama first. To use OpenAI, uncomment OPENAI_API_KEY and follow the
# same pattern.

# --- Cloud providers (leave commented to use the local Ollama default) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ENDPOINT=https://your-resource.openai.azure.com/   # Azure only
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
# AWS_REGION=us-east-1

# --- Force a specific model/source (overrides the local-first default) ---
# BIOMNI_LLM=claude-sonnet-4-5
# BIOMNI_SOURCE=Anthropic
# BIOMNI_DISABLE_LOCAL_FALLBACK=true   # set true to fail loudly if Ollama isn't running

# --- Custom / OpenAI-compatible model serving (vLLM, LM Studio, llama.cpp, etc.) ---
# CUSTOM_MODEL_BASE_URL=http://localhost:8000/v1
# CUSTOM_MODEL_API_KEY=your_custom_api_key_here
# BIOMNI_LLM=my-local-model
# BIOMNI_SOURCE=Custom

# --- Biomni data + execution settings ---
# BIOMNI_DATA_PATH=/path/to/your/data          # default: ./data
# BIOMNI_TIMEOUT_SECONDS=600                    # default: 600
# BIOMNI_TEMPERATURE=0.7                        # default: 0.7
# BIOMNI_USE_TOOL_RETRIEVER=true                # default: true
# BIOMNI_COMMERCIAL_MODE=false                  # default: false (academic; set true to filter non-commercial data)

# --- Ollama daemon (only needed if it's not on localhost:11434) ---
# OLLAMA_HOST=http://localhost:11434

# --- NCBI / Entrez (used by query_pubmed + Entrez-based tools) ---
# NCBI asks politely for an email on every Entrez request and will rate-limit
# requests that don't provide one. The bare-minimum placeholder
# "your-email@example.com" works but you'll hit throttling faster. Either
# variable name is accepted; NCBI_EMAIL is the canonical one.
# NCBI_EMAIL=you@example.com
# BIOMNI_NCBI_EMAIL=you@example.com
