# Biomentis .gitignore
#
# This file covers: personal scratch, run artifacts, runtime data, build
# output, environment files, editor/OS junk, and per-language caches.

# ============================================================
# A. Personal scratch + run artifacts at the repo root
# ============================================================

# Brainstorm / planning material (PO1 prompt files, xlsx trackers, etc.)
ideas/

# HTML / PNG / one-off scripts produced by past agent runs
output_generated/

# Protein structure files dropped at the repo root by structural pipelines
# (6nk5.pdb, 6nk6.pdb, 7klv.pdb, ...). Re-fetched as needed.
*.pdb

# Per-task scratch outputs from previous agent runs. Regenerated by the
# agent when you re-run the same prompt; the repo only ships the tools.
chikv_*
tp53_*
nanobody_*
binding_*
cross_reactivity_*
final_*

# Personal docs drafts (not user docs). The actual Biomentis user guide
# (docs/tutor.md) is tracked; the upstream Biomni paper and your
# scratch docx are not.
docs/future_RL_plans.md
docs/Biomni_science.adz4351-2.pdf
docs/PAT_Summary.docx

# ============================================================
# B. Runtime data, caches, and session storage
# ============================================================

# Tutor session storage: KB index + per-session JSONL log. Per-machine,
# not in the repo. Regenerated from the user's uploaded course materials.
data/tutor_kb/
data/tutor_logs/
data/biomni_data/
data_lake

# Same effect, kept as a catch-all for any other data/ subdir
data/

# Generic scratch
scratch/
logs/
*.log
*.jsonl
temp.*

# Tool installer cache: ~/biomentis_env/biomentis_tools/bin, etc.
biomentis_env/biomentis_tools/

# DDInter data files (downloaded on first use, license-restricted)
biomentis/tool/schema_db/ddinter_*.pkl
data/ddinter_raw/

# ============================================================
# C. Streamlit
# ============================================================

.streamlit/secrets.toml

# ============================================================
# D. Python — byte-compiled, packaging, distribution
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.so

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# PyInstaller
*.manifest
*.spec

# Translations
*.mo
*.pot

# C extensions / Cython
cython_debug/

# SageMath parsed files
*.sage.py

# PEP 582
__pypackages__/

# ============================================================
# E. Tests / coverage / type checkers / linters
# ============================================================

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
test.ipynb
.ipynb_checkpoints

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ============================================================
# F. Environments
# ============================================================

.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.envrc
uv.lock
poetry.lock

# pdm
.pdm.toml
.pdm-python
.pdm-build/

# ============================================================
# G. Editors / IDEs / OS
# ============================================================

.DS_Store
**/.DS_Store
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
.history/

# ============================================================
# H. Framework-specific caches (defensive)
# ============================================================

# Gradio (optional UI)
.gradio/
gradio_cached_examples/

# Django
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Celery
celerybeat-schedule
celerybeat.pid

# IPython
profile_default/
ipython_config.py

# mkdocs
/site

# ============================================================
# I. Docs build output
# ============================================================

docs/_build/
docs/build/
/docs/source/api/

# ============================================================
# J. Keep-on-disk-but-not-tracked misc
# ============================================================

# TODO scratch (editors create these)
TODO.md
NOTES.md
